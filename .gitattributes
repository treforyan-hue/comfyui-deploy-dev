# Scripts execute in Linux Docker — CRLF breaks bash. Force LF for all text.
* text=auto eol=lf
*.sh        text eol=lf
*.py        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
Dockerfile* text eol=lf
*.png  binary
*.jpg  binary
*.gif  binary
*.wav  binary
*.pt   binary
*.pth  binary
*.onnx binary
*.safetensors binary